# Copie para .env.local e preencha (Supabase → Project Settings → API).
# A chave publishable é pública por definição; a segurança dos dados fica nas regras RLS do banco.
# Nunca coloque aqui a chave service_role, senhas de banco ou tokens de API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Só para desenvolvimento local: senha das contas de demonstração (botões da tela Entrar).
VITE_DEMO_SENHA=
